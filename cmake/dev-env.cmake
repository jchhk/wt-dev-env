# Injected through CMAKE_PROJECT_TOP_LEVEL_INCLUDES by dev-env/cmake/presets.json.
# CMake includes this file right after the top-level project() call, so everything set
# here is inherited by the whole tree, including CPM dependencies added via add_subdirectory().
# Doing it here instead of in CMAKE_<LANG>_FLAGS keeps it independent of toolchain files
# (the Yocto OEToolchainConfig.cmake FORCE-overwrites CMAKE_<LANG>_FLAGS from the SDK env).

if(DEV_ENV_PREFIX_MAP)
    # Make objects, debug info and __FILE__ independent of the worktree location.
    # ccache knows this option and does not hash the absolute path inside it.
    # gdb then resolves sources relative to its cwd: start it from the worktree root,
    # or use:  set substitute-path . /path/to/worktree
    add_compile_options("-ffile-prefix-map=${CMAKE_SOURCE_DIR}=.")
endif()

if(DEV_ENV_LINKER)
    add_link_options("-fuse-ld=${DEV_ENV_LINKER}")
endif()

# Disk space: a Debug+testing tree is ~20G, mostly DWARF in .o, linked binaries and dist/.
# DEV_ENV_COMPRESS_DEBUG compresses the debug sections of linked executables and shared
# libraries (and therefore of dist/). Link-only: compile command lines and ccache hashes are
# unchanged, existing cache entries keep hitting. gdb reads zstd sections directly.
if(DEV_ENV_COMPRESS_DEBUG)
    add_link_options("LINKER:--compress-debug-sections=zstd")
endif()

# DEV_ENV_SPLIT_DWARF moves debug info into .dwo files next to the objects, so the linker no
# longer copies it into every binary. Changes the compile flags: one cold rebuild through
# ccache (the first worktree pays, the others then hit). With DEV_ENV_PREFIX_MAP the .dwo
# paths are relative like the sources: start gdb from the worktree root, and binaries in
# dist/ stay debuggable only while the build dir with its .dwo files exists.
if(DEV_ENV_SPLIT_DWARF)
    add_compile_options("-gsplit-dwarf")
endif()

# Persist the Yocto SDK environment of this configure run next to the build tree, as
# KEY=VALUE lines. Consumers: Emacs (dev-env/emacs/jchh-dev-env.el passes it to the compile
# process via `compilation-environment`, scoped to that one build) and `wt env <dir>`.
# Native build dirs get no .env, so they never see SDK variables.
if(DEFINED ENV{DEV_ENV_SDK} AND NOT "$ENV{DEV_ENV_SDK}" STREQUAL "")
    set(_dev_env_sdk_vars
        DEV_ENV_SDK OE_CMAKE_TOOLCHAIN_FILE
        PATH CCACHE_PATH
        CC CXX CPP AS LD AR NM RANLIB STRIP OBJCOPY OBJDUMP GDB
        CFLAGS CXXFLAGS CPPFLAGS LDFLAGS KCFLAGS
        ARCH CROSS_COMPILE TARGET_PREFIX CONFIG_SITE CONFIGURE_FLAGS
        SDKTARGETSYSROOT OECORE_TARGET_SYSROOT OECORE_NATIVE_SYSROOT
        OECORE_SDK_VERSION OECORE_DISTRO_VERSION OECORE_ACLOCAL_OPTS OECORE_TARGET_ARCH OECORE_TARGET_OS
        PKG_CONFIG_PATH PKG_CONFIG_SYSROOT_DIR OE_CMAKE_FIND_LIBRARY_CUSTOM_LIB_SUFFIX)
    set(_dev_env_content "# generated by dev-env.cmake from the SDK environment of the configure run; do not edit\n")
    foreach(_v IN LISTS _dev_env_sdk_vars)
        if(DEFINED ENV{${_v}})
            string(APPEND _dev_env_content "${_v}=$ENV{${_v}}\n")
        endif()
    endforeach()
    file(WRITE "${CMAKE_BINARY_DIR}/.env" "${_dev_env_content}")
    message(STATUS "dev-env: SDK environment saved to ${CMAKE_BINARY_DIR}/.env")
else()
    file(REMOVE "${CMAKE_BINARY_DIR}/.env")
endif()
